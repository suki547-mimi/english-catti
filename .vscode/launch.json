{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run English CATTI Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/english-extension",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/english-extension/out/**/*.js"
      ]
    }
  ]
}
