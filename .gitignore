# Audio files (generated, can be regenerated)
data/audio/
data/audio_test/

# Large raw external sources
Files/*.apkg
data/external/*.js
data/external/*.csv.bak

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# VS Code local artifacts
.vscode/*.log
.vscode/settings.json
!.vscode/mcp.json

# Temp / debug logs
tools/_*.txt
tools/_*.log
tools/_*.err
tools/_test_*.py

# Daily state backups (kept locally by extension)
data/user_state.backup-*.json

# Daily LLM-generated reading corner articles (regenerated each day; noisy)
data/reading_corner/daily/

# OS junk
Thumbs.db
.DS_Store
desktop.ini
